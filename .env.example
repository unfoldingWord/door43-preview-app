# door43-preview-app configuration. Copy to .env and adjust.
# Only DCS_READ_ONLY_TOKEN and PREVIEW_VERIFICATION_KEY usually need setting for
# local dev; everything else has a sensible default (shown commented). See
# docs/OPERATIONS.md for the full picture and per-environment (local/QA/prod) setup.

# ─── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
CACHE_DIR=./cached-files
# NODE_ENV=production        # production also serves the built SPA from dist/

# ─── DCS (which Door43 instance to read) ─────────────────────────────────────────
# Resolution order: ?server= (PROD|QA|DEV) on a request > DCS_HOST env > the app's
# own hostname (preview.door43.org -> PROD) > default (QA). So prod usually needs
# nothing here; local/QA default to qa.door43.org.
#   PROD = https://git.door43.org   QA = https://qa.door43.org   DEV = https://develop.door43.org
# DCS_HOST=QA

# Optional read token for authenticated/public-repo access (see below for how to make one).
DCS_READ_ONLY_TOKEN=

# ─── Verification (cache-upload shared secret) ──────────────────────────────────
# openssl rand -hex 32  (auto-generated if left as-is, but set it in shared envs)
PREVIEW_VERIFICATION_KEY=your_secret_key_here

# ─── HTML -> PDF (WeasyPrint sidecar) ───────────────────────────────────────────
# In docker-compose this is http://weasyprint:8080 automatically. For host dev
# against a sidecar container: WEASYPRINT_SERVICE_URL=http://localhost:8080
# WEASYPRINT_SERVICE_URL=http://localhost:8080
# OBS images are baked into the sidecar image; swap resolution at build time:
# OBS_IMAGES_URL=https://cdn.door43.org/obs/jpg/obs-images-720px.zip

# ─── Cache backend ──────────────────────────────────────────────────────────────
# disk (default) for dev; S3 for QA/prod. Set AWS_S3_BUCKET to auto-select S3, or
# force with PREVIEW_CACHE_BACKEND=disk|s3.
# PREVIEW_CACHE_BACKEND=disk
# AWS_S3_BUCKET=
# AWS_REGION=us-west-2
# AWS_S3_PREFIX=preview-cache
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the env/instance role (prod: openbao).

# ─── PDF render queue ───────────────────────────────────────────────────────────
# In-process by default. Set REDIS_URL to use BullMQ (persistent, multi-worker).
# REDIS_URL=redis://localhost:6379
# PREVIEW_JOB_CONCURRENCY=2      # concurrent renders
# PREVIEW_WORKER=off             # this container serves web only; a worker container processes jobs

# ─── Logging ────────────────────────────────────────────────────────────────────
# Off: startup + cron cycles + render start/stop + warnings/errors only.
# On: also the per-request access log, cache HIT/MISS timings, downloads. (client: ?debug=1)
# DEBUG_MODE=1

# ─── Cache warming + cron ───────────────────────────────────────────────────────
# Master switch — WITHOUT this, NO cron runs and the container warms nothing.
# RUN_CRONS=1
# Required to use the /api/warm endpoint (shared secret with whoever triggers it).
# WARM_TOKEN=
# Schedule the warming cron (ms). Also needs RUN_CRONS=1.
# WARM_INTERVAL_MS=3600000
# WARM_DCS_HOST=PROD                     # which DCS to warm from (default = app default)
# WARM_MAX_ENQUEUE_PER_CYCLE=200         # pace the fill so a cycle can't flood the queue
# WARM_SEARCH_LIMIT=100                  # catalog/search?stage=prod&limit=
# WARM_SEARCH_QUERY=                     # extra search params, e.g. lang=en
# WARM_PAGE_SIZES=A4_PORTRAIT,US_LETTER_PORTRAIT
# WARM_FIRST_DELAY_MS=10000
# WARM_ENUM_CONCURRENCY=8

# ─── Advanced / tuning ──────────────────────────────────────────────────────────
# REF_SHA_TTL_MS=15000                   # branch ref->sha cache TTL (staleness detection lag)
# REF_SHA_TAG_TTL_MS=86400000            # tag ref->sha TTL (tags are immutable -> long)
# PREVIEW_CACHE_VERSION=                 # override the renderer-output cache-buster
