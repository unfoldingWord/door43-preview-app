# door43-preview-app — local dev against a DCS running on THIS machine.
#
#   cp .env.local-dcs.example .env      (or merge these keys into your existing .env)
#
# Port map, and why:
#   3000  local DCS (Gitea)   — it owns 3000; its ROOT_URL and clone URLs are built
#                               from that, so the preview app moves instead.
#   3001  preview app         — host dev (`pnpm dev:server`) and the published
#                               container port (the container still listens on 3000).
#   5173  Vite dev server     — proxies /api to PORT below.
#   8080  WeasyPrint sidecar  — published by docker-compose.local.yml.
#
# See docs/OPERATIONS.md §15 for the full walkthrough. Everything not listed here
# keeps its default — .env.example documents the complete set.

# ─── Core ──────────────────────────────────────────────────────────────────────
# The API port for host dev. vite.config.js reads this too, so the /api proxy follows.
PORT=3001
# Host port the `app` container publishes (container-internal port stays 3000).
APP_HOST_PORT=3001
CACHE_DIR=./cached-files

# ─── DCS: the instance on this machine ─────────────────────────────────────────
# Must be a hostname the BROWSER can resolve as well as the containers — rendered
# pages embed absolute DCS URLs. `dcs-local` satisfies both:
#   host:       /etc/hosts       -> 127.0.0.1  dcs-local
#   containers: extra_hosts      -> dcs-local:host-gateway
# `localhost` would break inside containers; `host.docker.internal` would break in
# the browser. Start DCS from ~/repos/dcs with: ./gitea web
DCS_HOST=http://dcs-local:3000

# Optional. A local DCS with public repos needs no token; set one from
# dcs-local:3000 -> Settings -> Applications if you preview private repos.
DCS_READ_ONLY_TOKEN=

# ─── Cache: disk, never the shared S3 bucket ───────────────────────────────────
# Forced so a local warm cron cannot write into a shared bucket. Leave AWS_S3_BUCKET
# unset here — setting it would auto-select the S3 backend.
PREVIEW_CACHE_BACKEND=disk

# ─── Local dev secrets (not secret — do not reuse anywhere shared) ─────────────
PREVIEW_VERIFICATION_KEY=local-dev-verification-key
WARM_TOKEN=local-dev-warm-token

# ─── Logging ───────────────────────────────────────────────────────────────────
DEBUG_MODE=1

# ─── Crons ─────────────────────────────────────────────────────────────────────
# Leave RUN_CRONS unset here. docker-compose.local.yml turns it on for the `worker`
# container only, so warming is scheduled exactly once. Set it in this file only if
# you want the warm cron while running on the host (`pnpm dev:server`), in which case
# also set WARM_INTERVAL_MS and keep the pacing low:
# RUN_CRONS=1
# WARM_INTERVAL_MS=900000
# WARM_DCS_HOST=http://dcs-local:3000
# WARM_SEARCH_LIMIT=10
# WARM_MAX_ENQUEUE_PER_CYCLE=6
# WARM_PAGE_SIZES=A4_PORTRAIT

# ─── HTML -> PDF sidecar (host dev only) ───────────────────────────────────────
# The containers reach it as http://weasyprint:8080 automatically. Uncomment when
# running the server on the host against the published sidecar:
# WEASYPRINT_SERVICE_URL=http://localhost:8080

# ─── Faster staleness feedback while editing content in local DCS ──────────────
# Branch ref->sha is cached 15s by default; drop it to see commits reflected sooner.
# REF_SHA_TTL_MS=3000
